NODE_ENV=development
PORT=3000
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/nightclub_platform?schema=public
JWT_ACCESS_SECRET=change-me-access
JWT_REFRESH_SECRET=change-me-refresh
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_EXPIRES_IN=7d

QR_SIGNING_ACTIVE_VERSION=v1
# JSON de claves versionadas. Conserva claves antiguas mientras existan QR emitidos con ellas.
QR_SIGNING_KEYS_JSON={"v1":"replace-with-at-least-32-random-characters"}
PLATFORM_COMMISSION_BPS=1000
PAYMENT_PROVIDER_COST_BPS=0
WITHDRAWAL_MIN_CENTS=5000
FINANCIAL_DATA_ENCRYPTION_KEY=replace-with-a-long-random-secret

REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:5173

AWS_REGION=us-east-1
AWS_S3_BUCKET=nightclub-platform-dev-assets
AWS_CLOUDFRONT_URL=https://cdn.example.com
AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me

PAYMENT_PROVIDER=mercado_pago
ORDER_PAYMENT_PROVIDER=mercado_pago
WALLET_TOP_UP_PAYMENT_PROVIDER=mercado_pago
MAX_MARKETPLACE_FEE_BPS=3000

# MOBILE_ANDROID_PACKAGE=com.beerry.app
# MOBILE_APP_SCHEME=beerry

# Mercado Pago marketplace. Never expose these values to Flutter.
MERCADO_PAGO_CLIENT_ID=
MERCADO_PAGO_CLIENT_SECRET=
MERCADO_PAGO_REDIRECT_URI=https://api.beerry.app/api/v1/payments/mercado-pago/oauth/callback
MERCADO_PAGO_NOTIFICATION_URL=https://api.beerry.app/api/v1/payments/mercado-pago/webhook
MERCADO_PAGO_WEBHOOK_SECRET=
MERCADO_PAGO_PLATFORM_ACCESS_TOKEN=
MERCADO_PAGO_OAUTH_STATE_SECRET=
SELLER_CREDENTIALS_ENCRYPTION_KEY=
MOBILE_APP_SCHEME=beerry
MERCADO_PAGO_TEST_PAYER_EMAIL=
MERCADO_PAGO_OAUTH_TEST_TOKEN=false
WALLET_TOP_UP_MIN_CENTS=200
WALLET_TOP_UP_MAX_CENTS=100000

PUSH_NOTIFICATION_PROVIDER=simulated
FIREBASE_PROJECT_ID=your-firebase-project-id
# Use Application Default Credentials in AWS/Google environments, or provide one-line JSON locally.
FIREBASE_SERVICE_ACCOUNT_JSON=

PHONE_MESSAGE_PROVIDER=dev
TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_KEY=SKxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
TWILIO_API_SECRET=change-me
TWILIO_PHONE_NUMBER=+10000000000
