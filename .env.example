AWS_ACCESS_KEY_ID=change-me
AWS_SECRET_ACCESS_KEY=change-me

PAYMENT_PROVIDER=simulated

FLOW_ENVIRONMENT=sandbox
FLOW_API_KEY=
FLOW_SECRET_KEY=
