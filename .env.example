QR_SIGNING_KEYS_JSON={"v1":"replace-with-at-least-32-random-characters"}
PLATFORM_COMMISSION_BPS=1000
PAYMENT_PROVIDER_COST_BPS=0
WITHDRAWAL_MIN_CENTS=5000
FINANCIAL_DATA_ENCRYPTION_KEY=replace-with-a-long-random-secret

REDIS_URL=redis://localhost:6379
CORS_ORIGIN=http://localhost:5173

AWS_REGION=us-east-1
